---
import BaseLayout from "../layouts/BaseLayout.astro";

type PetProject = {
  name: string;
  href: string;
  repo?: string;
  description: string;
  technologies: string;
};

const petProjects: PetProject[] = [
  {
    name: "Movies that feel like",
    href: "https://mtfl.maxarias.com/",
    repo: "https://github.com/max-arias/movies-that-feel-like",
    description: `A discovery site for r/MoviesThatFeelLike, where people post an image and ask for films that
      feel the same. A scheduled Python pipeline pulls posts and full comment trees from the Arctic Shift
      archive, has an LLM read each thread for concrete film and TV recommendations plus a one-line vibe
      summary, resolves every title against TMDB and IGDB, and emits id-free upserts into Cloudflare D1 — the
      deployed database is rebuilt from migrations rather than hand-edited. Because Reddit answers a deleted
      gallery image with a placeholder PNG, a separate probe tracks image liveness, and a post stays published
      only while one real image survives.`,
    technologies: "Astro · Cloudflare Pages/Workers · D1 · Python · Tailwind CSS · daisyUI",
  },
  {
    name: "SFF build planner",
    href: "https://sff.maxarias.com/",
    repo: "https://github.com/max-arias/sff-website",
    description: `Pick a case, GPU, PSU, cooler, motherboard, and RAM, and it reports what fits: pass,
      conditional, or fail per constraint, each verdict carrying the measurement behind it — anything inside 5 mm
      reads as a tight fit rather than a clean pass. The whole 8,489-row catalog ships to the browser as one
      gzipped SQLite file that a Web Worker caches and reopens in memory through sqlite-wasm, so filtering and
      search run locally and never touch the database, using the same FTS5 trigram index the server does. Slots
      and filters live in the URL, so any build can be shared and replayed.`,
    technologies: "Astro · Tailwind CSS · Cloudflare D1 · TypeScript",
  },
  {
    name: "poe-shopping-list",
    href: "https://github.com/max-arias/poe-shopping-list",
    description: `A Chrome side-panel extension for Path of Exile that keeps several named shopping lists of
      Trade searches. It opens only on the official Trade site, registers the search you are looking at as an
      item, and stores everything in local browser storage — no account, no server, no network calls, just two
      permissions and the Trade hosts. Sharing works offline through the psl1. share code, which wraps gzip and
      base64url over a strict versioned schema with CRC32 and single-member checks, so a bad import is rejected
      with the pasted text kept for editing, and every import lands as an independent local copy. A companion
      static catalog publishes curated lists.`,
    technologies: "WXT · Vue 3 · Pinia · Zod · Tailwind CSS · VitePlus",
  },
  {
    name: "Level up fixes",
    href: "https://thunderstore.io/c/riskofrain2/p/TeamTayne/LevelUpChoicesFixes/",
    repo: "https://github.com/max-arias/level-up-fixes",
    description: `A BepInEx add-on for Risk of Rain 2 that fixes and extends the LevelUpChoices mod. It patches
      eleven upstream methods across LevelUpChoices and the game itself with Harmony — reading ten private fields
      by reflection and checking each seam's signature, so an upstream change degrades with a logged warning
      instead of a crash — and adds configurable item-quality rolls with weighted tiers and a guaranteed-quality
      cadence. Item-source removal runs off a single policy list, capped at four equipment barrels per stage, and
      the host's eleven settings sync to clients over an R2API message. A Python suite parses those policy lists
      and asserts that every one of the game's 67 stage-pool cards is either blocked or deliberately kept.`,
    technologies: "C# · BepInEx · R2API · Risk of Rain 2 · Thunderstore",
  },
  {
    name: "Command Queue save/load",
    href: "https://thunderstore.io/c/riskofrain2/p/TeamTayne/CommandQueueSaveLoad/",
    repo: "https://github.com/max-arias/command-queue-save-load",
    description: `A BepInEx add-on for Risk of Rain 2 that gives CommandQueue a separate saved plan for each survivor.
      Save and open buttons sit on CommandQueue's own row, while an optional automatic load restores the starting
      survivor's plan at the beginning of a run. The live queue can be consumed or reset without touching the saved
      copy, and the storage stays in readable JSON — with missing modded items preserved and skipped rather than
      silently discarded. It reads CommandQueue's public state and API without patching the dependency.`,
    technologies: "C# · BepInEx · CommandQueue · Risk of Rain 2 · Thunderstore",
  },
];
---

<BaseLayout
  title="Pet projects | Maximiliano Arias"
  description="Personal projects by Maximiliano Arias, including small web products, a local-only browser extension, and Risk of Rain 2 mods."
  canonical="https://maxarias.com/pet-projects"
>
  <main class="mx-auto min-h-screen max-w-page px-6 py-14 sm:px-8 sm:py-20 fade-in-page">
    <div class="mx-auto max-w-2xl">
      <header class="mb-14 fade-in-up" style="--fade-delay: 80ms;">
        <a class="button-link" href="/">← Back to home</a>
        <div class="mt-10">
          <p class="section-label mb-4">Personal</p>
          <h1 class="text-[1.85rem] font-semibold tracking-[-0.035em] text-white sm:text-[2rem]">Pet projects</h1>
          <p class="mt-4 max-w-[34rem] text-[1.05rem] leading-[1.75] text-white/62 sm:text-[1.08rem]">
            Small, useful experiments built around the things I enjoy exploring outside client work.
          </p>
        </div>
      </header>

      <section class="section-block fade-in-up" style="--fade-delay: 180ms;" aria-labelledby="projects-heading">
        <div class="section-heading-row">
          <h2 id="projects-heading" class="section-label">Projects</h2>
          <span class="section-note">Built and maintained</span>
        </div>

        <div class="space-y-7">
          {petProjects.map((project) => (
            <article class="entry">
              <div class="entry-header">
                <h3>
                  <a href={project.href} target="_blank" rel="noreferrer">{project.name}</a>
                  {project.repo && (
                    <>
                      <span class="entry-sep" aria-hidden="true">·</span>
                      <a
                        class="entry-repo"
                        href={project.repo}
                        target="_blank"
                        rel="noreferrer"
                        aria-label={`${project.name} source code on GitHub`}
                      >
                        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.07-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.15 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                        </svg>
                      </a>
                    </>
                  )}
                </h3>
              </div>
              <p>{project.description.replace(/\s+/g, " ")}</p>
              <p class="entry-meta"><span>Built with</span> {project.technologies}</p>
            </article>
          ))}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
