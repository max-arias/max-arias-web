---
import BaseLayout from "../layouts/BaseLayout.astro";

const personSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://www.max-arias.com/#person",
      name: "Maximiliano Arias",
      alternateName: "Max Arias",
      url: "https://www.max-arias.com/",
      jobTitle: "Staff Front-End Engineer / Frontend Fortress Lead",
      description:
        "Senior frontend and frontend platform engineer with 15+ years of experience building web products, browser extensions, mobile experiences, and shared UI systems.",
      sameAs: [
        "https://www.linkedin.com/in/maxarias/",
        "https://github.com/max-arias/",
        "https://product.ai/about/max-arias/",
      ],
      knowsAbout: [
        "Frontend platform engineering",
        "Browser extensions",
        "Shared frontend infrastructure",
        "Cross-product design systems",
        "TypeScript and JavaScript",
        "Vue and Nuxt",
        "React Native and Expo",
        "Design systems and shared component libraries",
        "CI/CD and release automation",
        "Headless CMS and Git-based publishing",
        "Cloudflare Workers",
        "AI chat, retrieval, and evaluation",
        "Testing, metadata, and schema",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://www.max-arias.com/#website",
      url: "https://www.max-arias.com/",
      name: "Maximiliano Arias",
      description: "The professional homepage of Maximiliano Arias.",
      publisher: { "@id": "https://www.max-arias.com/#person" },
    },
    {
      "@type": "ProfilePage",
      "@id": "https://www.max-arias.com/#profilepage",
      url: "https://www.max-arias.com/",
      name: "Maximiliano Arias | Senior Frontend Platform Engineer",
      isPartOf: { "@id": "https://www.max-arias.com/#website" },
      mainEntity: { "@id": "https://www.max-arias.com/#person" },
    },
  ],
};

const petProjects = [
  {
    name: "movies-that-feel-like",
    href: "https://movies-that-feel-like.max-c82.workers.dev/",
    description: "A read-only discovery site built from Reddit movie recommendations.",
    technologies: "Astro · Cloudflare Pages/Workers · D1 · Python · Tailwind CSS · daisyUI",
  },
  {
    name: "sff-website",
    href: "https://sff-pc-builder.max-c82.workers.dev/",
    description: "A fitment engine for planning small-form-factor PC builds.",
    technologies: "Astro · Tailwind CSS · Cloudflare D1 · TypeScript",
  },
  {
    name: "poe-shopping-list",
    href: "https://github.com/max-arias/poe-shopping-list",
    description: "A local-only Path of Exile shopping-list browser extension.",
    technologies: "WXT · Vue 3 · Pinia · Zod · Tailwind CSS · VitePlus",
  },
];
---

<BaseLayout
  title="Maximiliano Arias | Senior Frontend Platform Engineer"
  description="Senior frontend and frontend platform engineer with 15+ years of experience building web products, browser extensions, mobile experiences, and shared UI systems."
  canonical="https://www.max-arias.com/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  </Fragment>
  <main class="mx-auto min-h-screen max-w-page px-6 py-14 sm:px-8 sm:py-20 fade-in-page">
    <div class="mx-auto max-w-2xl">
      <header class="mb-14 fade-in-up" style="--fade-delay: 80ms;">
        <div class="mb-6">
          <h1 class="text-[1.85rem] font-semibold tracking-[-0.035em] text-white sm:text-[2rem]">Maximiliano Arias</h1>
          <p class="mt-1 text-[0.95rem] text-white/52">Senior frontend / frontend platform engineer</p>
        </div>

        <div class="space-y-4">
          <p class="max-w-[34rem] text-[1.05rem] leading-[1.75] text-white/76 sm:text-[1.08rem]">
            I am a senior frontend and frontend platform engineer with 15+ years of experience building web products, browser extensions, mobile experiences, and shared UI systems.
          </p>
          <p class="max-w-[34rem] text-[0.95rem] leading-[1.7] text-white/48">
            My toolkit spans TypeScript and JavaScript, Vue/Nuxt, and React Native/Expo, with a focus on design systems, shared component libraries, and CI/CD and release automation. I also work with headless CMS and Git-based publishing, Cloudflare Workers/KV/R2, AI chat, retrieval and evaluation, and testing, metadata, and schema.
          </p>
        </div>

        <nav class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-[0.95rem] text-white/58">
          <a class="button-link" href="mailto:max@max-arias.com">Email</a>
          <a class="button-link" href="https://www.linkedin.com/in/maxarias/" target="_blank" rel="noreferrer">LinkedIn</a>
          <a class="button-link" href="https://github.com/max-arias/" target="_blank" rel="noreferrer">GitHub</a>
          <a class="button-link" href="/resume">CV</a>
        </nav>
      </header>

      <div class="space-y-12">
        <section class="section-block fade-in-up" style="--fade-delay: 180ms;" aria-labelledby="selected-work-heading">
          <div class="section-heading-row">
            <h2 id="selected-work-heading" class="section-label">Selected work</h2>
            <span class="section-note">Recent</span>
          </div>

          <div class="space-y-7">
            <article class="entry">
              <div class="entry-header">
                <h3>Demand.io / Product.ai</h3>
                <span><time datetime="2021-09">September 2021</time>–Present</span>
              </div>
              <p>
                Since September 2021, as Staff Front-End Engineer / Frontend Fortress Lead, I have worked across SimplyCodes, Dealspotr, Knoji, and Product.ai on web, browser extension, mobile, and shared UI. Selected work includes SimplyCodes modernization across routing, canonicalization, testing, and release flow; a WXT reset with multiplatform releases, Safari, analytics, and Jenkins-to-GitHub Actions; cross-product design systems and shared infrastructure; CMS and Git-based publishing delivered with Cloudflare Workers/KV/R2; Product.ai Cloudflare Worker site, Research Hub, recruiting, and schema JSON-LD; AI chat, trust, evidence, extension-connected shopping, and retrieval prototypes; and synthetic-monitoring readiness, SEO safety, operational, and performance fixes.
              </p>
            </article>

            <article class="entry">
              <div class="entry-header">
                <h3>Truelogic Software</h3>
                <span><time datetime="2011">2011</time>–<time datetime="2021">2021</time></span>
              </div>
              <p>
                Selected engagements included LeafLink, Minted, SoulCycle, and Evernote. At LeafLink, I reduced bundle and image payloads by roughly 30%; at Minted, I built Lighthouse/Puppeteer tooling for synthetic performance metrics.
              </p>
            </article>
          </div>
        </section>

        <section class="section-block fade-in-up" style="--fade-delay: 240ms;" aria-labelledby="pet-projects-heading">
          <div class="section-heading-row">
            <h2 id="pet-projects-heading" class="section-label">Pet projects</h2>
            <span class="section-note">Personal</span>
          </div>

          <div class="space-y-7">
            {petProjects.map((project) => (
              <article class="entry">
                <div class="entry-header">
                  <h3>
                    <a href={project.href} target="_blank" rel="noreferrer">{project.name}</a>
                  </h3>
                </div>
                <p>{project.description}</p>
                <p class="entry-meta"><span>Built with</span> {project.technologies}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="section-block fade-in-up" style="--fade-delay: 280ms;" aria-labelledby="contact-heading">
          <div class="section-heading-row">
            <h2 id="contact-heading" class="section-label">Contact</h2>
            <span class="section-note">Available</span>
          </div>

          <p class="max-w-[32rem] text-[0.96rem] leading-[1.75] text-white/62">
            Available for consulting, collaboration, and new opportunities. Get in touch at
            <a href="mailto:max@max-arias.com" class="inline-link">max@max-arias.com</a>
          </p>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>
